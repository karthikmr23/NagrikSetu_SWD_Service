# ==============================================================================
# NAGRIKSETU SOCIAL WELFARE DEPARTMENT (SWD) MICROSERVICE
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Service Metadata
SERVICE_NAME=swd-service
ENVIRONMENT=development
PORT=8004
LOG_LEVEL=INFO

# MySQL Database Configuration (Dedicated nagriksetu_swd database on host port 3306)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=nagriksetu_swd
DB_USER=swd_app
DB_PASSWORD=swd-secure-pass-2026

# Security & JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demonstration Accounts
ADMIN_EMAIL=swd.admin@nagriksetu.local
ADMIN_PASSWORD=SWDAdmin@2026!

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8004,http://localhost:8005,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# RabbitMQ Event Integration
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=nagriksetu
RABBITMQ_PASSWORD=rabbitmq-pass-2026
RABBITMQ_EXCHANGE=nagriksetu.events
RABBITMQ_ENABLED=false

# Document Upload & Storage Settings
UPLOAD_DIR=./uploads/documents
MAX_UPLOAD_SIZE_MB=5
